# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the app (used in emails, Stripe redirect URLs).
APP_URL=http://localhost:3000

# --- Supabase (auth + Postgres) ---
# Local dev: run `pnpm sb:start`, then copy values from `pnpm sb:status`.
# Project URL, e.g. https://xyz.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...); safe for the browser, RLS still applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key; SERVER ONLY, bypasses RLS. Not used yet.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string used by Drizzle (pooled URL for the app).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- Dev only (REMOVE in Phase 6 when Stripe lands) ---
# "true" shows a Simulate payment button on draft orders. Ignored when NODE_ENV=production.
DEV_FAKE_PAYMENTS=

# --- Cloudflare R2 (S3 API) ---
# Cloudflare account id; endpoint is https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# R2 API token access key id / secret with read+write on the bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket holding all order files.
R2_BUCKET=

# --- Stripe (Checkout + Connect Express) ---
# Secret key (sk_test_... in dev).
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/stripe (from `stripe listen` in dev).
STRIPE_WEBHOOK_SECRET=
# Publishable key for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (email) ---
# API key for transactional email.
RESEND_API_KEY=
# From address on a verified domain, e.g. "Mixdrop <orders@example.com>".
EMAIL_FROM=
